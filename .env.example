# Скопіюйте цей файл у .env і заповніть потрібні секції.
# Якщо .env немає або секція порожня — відповідний модуль автоматично працює
# у безпечному fallback-режимі (без LLM / TF-IDF замість Qdrant / демо-логін
# замість LDAP), застосунок при цьому НЕ ламається.

# --- 1. AI та RAG: чат-асистент і автогенерація тестів з ОП --------------
# Хмарний OpenAI:
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Або локальна Ollama (не потребує OPENAI_API_KEY, Ollama сумісна з OpenAI API):
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_CHAT_MODEL=llama3.1

# --- 2. Векторний пошук по базі знань --------------------------------------
VECTOR_BACKEND=tfidf
# VECTOR_BACKEND=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=kb_documents

# --- 3. Active Directory / LDAP (реальний SSO замість демо-логіну) --------
LDAP_SERVER=
# LDAP_SERVER=ldap://dc01.company.local
LDAP_BASE_DN=dc=company,dc=local
LDAP_DOMAIN=COMPANY
LDAP_USE_SSL=0

# --- 4. PostgreSQL (довідково, див. postgres_schema.sql) ------------------
DATABASE_URL=
# DATABASE_URL=postgresql://user:password@localhost:5432/hr_portal
